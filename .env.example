# Session signing secret (auto-generated in data/.secret if omitted)
SESSION_SECRET=

# Comma-separated Google emails that automatically receive OWNER role
OWNER_EMAILS=

# Firebase Web SDK configuration (can also be configured in /owner panel)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 9router AI Auto Jawab (opsional; otomatis memakai 9router VPS 165.245.190.115:20128 jika kosong)
NINEROUTER_BASE_URL=http://165.245.190.115:20128
NINEROUTER_API_KEY=
NINEROUTER_MODEL=ag/gemini-3.8-flash

# Kunci enkripsi AES-256-GCM opsional untuk vault secret AI (64 karakter hex atau string bebas)
APP_ENCRYPTION_KEY=
